# --- dependencies: never publish or commit these -------------------------
node_modules/
.npm-cache/
package-lock.json

# --- build output: regenerated by tools/build-dist.mjs -------------------
# The Pages workflow builds dist/ in CI and uploads it directly. Committing a
# copy would duplicate ~1 MB of binary art in history and let it drift from
# source. Run `node tools/build-dist.mjs` whenever you need it locally.
dist/

# --- verification harness: dev-only, not part of the game ----------------
# tests/ holds the browser suites and their screenshots. Keep it in git if you
# want the verification history, but it must never be served to players.
tests/

# --- generated scratch files from the i18n tooling -----------------------
# static/i18n/ ships only en.json, ja.json and zh.json. The _*.cjs helpers and
# _*-output.txt captures are how I18N-NOTES.md was generated; they are not
# loaded by the game.
static/i18n/_*

# --- editor / OS noise ---------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
